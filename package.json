{
  "name": "jeremy.ng",
  "version": "0.0.0",
  "description": "Personal website for Jeremy Nguyen",
  "type": "module",
  "keywords": [
    "personal-site",
    "portfolio",
    "personal",
    "personal-website",
    "portfolio-site",
    "personal-portfolio"
  ],
  "homepage": "https://github.com/jeremy-code/jeremy.ng#readme",
  "bugs": "https://github.com/jeremy-code/jeremy.ng/issues",
  "license": "MIT",
  "author": "Jeremy Nguyen <hi@jeremy.ng> (https://jeremy.ng)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeremy-code/jeremy.ng.git"
  },
  "scripts": {
    "prepare": "husky",
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "eslint && turbo lint",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "turbo typecheck",
    "codegen": "turbo codegen",
    "test": "turbo test"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/types": "^21.2.3",
    "@jeremyng/eslint-config": "workspace:*",
    "@jeremyng/tsconfig": "workspace:*",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "download",
      "version": "12.9.1"
    },
    "runtime": [
      {
        "name": "node",
        "onFail": "download",
        "version": "24.21.0"
      }
    ]
  }
}
